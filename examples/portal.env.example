# ==============================================================================
# Fayda Developer Portal Export (.env) Example
# ==============================================================================
# This matches the exact format exported directly by the Fayda eSignet portal
# (https://esignet.ida.fayda.et / https://esignet.sandbox.fayda.et).
#
# Fayda MCP seamlessly loads these variables without requiring manual renaming.
# FAYDA_ prefixed variables (e.g. FAYDA_CLIENT_ID) take precedence if both are set.
# ==============================================================================

# Registered Fayda Relying Party Client ID
CLIENT_ID=your_fayda_portal_client_id_here

# Registered Redirect / Callback URI
REDIRECT_URI=http://localhost:3000/callback

# OIDC Endpoints exported by Fayda Portal
AUTHORIZATION_ENDPOINT=https://esignet.ida.fayda.et/authorize
TOKEN_ENDPOINT=https://esignet.ida.fayda.et/v1/esignet/oauth/v2/token
USERINFO_ENDPOINT=https://esignet.ida.fayda.et/v1/esignet/oidc/userinfo

# Client Private Signing Key: Base64-encoded RSA JWK JSON (as exported by Fayda portal)
# Alternatively: direct PEM string, raw JSON JWK, or path to private key file.
# Note: Fayda MCP decodes this key and derives the Key ID (kid) automatically.
# PRIVATE_KEY is NEVER logged or exposed in error messages.
PRIVATE_KEY=eyJr...

# Optional explicit Key ID (if not embedded in the JWK)
# KEY_ID=ef697e49-963f-4417-bf21-8b06bccbcecc

# Client Assertion Expiration Time
# The portal exports '15' (15 minutes). Values <= 60 are mapped as minutes (15 -> 900s).
# Suffixes are also supported, e.g. 15m, 900s.
EXPIRATION_TIME=15

# Signing algorithm (default: RS256)
ALGORITHM=RS256

# OAuth 2.0 Client Assertion Type
CLIENT_ASSERTION_TYPE=urn:ietf:params:oauth:client-assertion-type:jwt-bearer

# ==============================================================================
# Optional Overrides (FAYDA_ variables take precedence over portal variables)
# ==============================================================================
# Fayda MCP automatically resolves issuer and JWKS URL via trusted OIDC discovery
# (https://esignet.ida.fayda.et/.well-known/openid-configuration).
# If you wish to explicitly override them:
# FAYDA_ISSUER=https://esignet.ida.fayda.et
# FAYDA_JWKS_URL=https://esignet.ida.fayda.et/.well-known/jwks.json
# FAYDA_STORAGE_MODE=memory
