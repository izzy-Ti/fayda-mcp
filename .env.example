APP_ENV=development
APP_NAME=fayda-mcp-bridge
PUBLIC_BASE_URL=https://bridge.example.com
LOG_LEVEL=INFO
ALLOWED_HOSTS=["bridge.example.com","localhost"]
CORS_ORIGINS=["https://portal.example.com"]

# SQLAlchemy psycopg URLs. URL-encode username and password.
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST-pooler/DB?sslmode=require
DATABASE_MIGRATION_URL=postgresql+psycopg://USER:PASS@HOST/DB?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

REDIS_URL=rediss://default:PASSWORD@HOST:6379/0
REDIS_KEY_PREFIX=fayda_bridge:dev:
OIDC_SESSION_TTL_SECONDS=600
VERIFICATION_LINK_TTL_SECONDS=600
RESULT_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=30

# Bridge OAuth resource, independent of Fayda
MCP_RESOURCE_URL=https://bridge.example.com/mcp
MCP_AUTH_ISSUER=https://auth.example.com/
MCP_AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
MCP_REQUIRED_SCOPES=["verification:create","verification:read"]

# Provider endpoints supplied/confirmed during Fayda onboarding
FAYDA_ENVIRONMENT=sandbox
FAYDA_ISSUER_URL=https://REPLACE_APPROVED_ISSUER
FAYDA_AUTHORIZATION_URL=https://REPLACE_APPROVED_AUTH_ENDPOINT
FAYDA_TOKEN_URL=https://REPLACE_APPROVED_TOKEN_ENDPOINT
FAYDA_USERINFO_URL=https://REPLACE_APPROVED_USERINFO_ENDPOINT
FAYDA_JWKS_URL=https://REPLACE_APPROVED_JWKS_ENDPOINT
FAYDA_REDIRECT_URI=https://bridge.example.com/auth/fayda/callback
FAYDA_ALLOWED_ALGORITHMS=["RS256"]
FAYDA_HTTP_TIMEOUT_SECONDS=10
FAYDA_CLIENT_ASSERTION_TTL_SECONDS=120

SECRETS_BACKEND=vault
SECRETS_BASE_URL=https://vault.example.com
SECRETS_NAMESPACE=fayda-bridge
# Prefer workload identity over a long-lived vault token.
AUDIT_RETENTION_DAYS=90
RESULT_RETENTION_DAYS=30
JWT_CLOCK_SKEW_SECONDS=60
JWKS_CACHE_TTL_SECONDS=300
