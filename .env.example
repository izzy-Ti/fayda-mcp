FAYDA_CLIENT_ID=business_registered_client_id
FAYDA_REDIRECT_URI=https://developer-app.example/auth/fayda/callback
FAYDA_ISSUER_URL=https://APPROVED_ISSUER
FAYDA_AUTHORIZATION_URL=https://APPROVED_AUTH_ENDPOINT
FAYDA_TOKEN_URL=https://APPROVED_TOKEN_ENDPOINT
FAYDA_USERINFO_URL=https://APPROVED_USERINFO_ENDPOINT
FAYDA_JWKS_URL=https://APPROVED_JWKS_ENDPOINT
FAYDA_SIGNING_KEY_PATH=/run/secrets/fayda_signing_key.json

# Optional adapters: host controls accounts and credentials.
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST-pooler/DB?sslmode=require
DATABASE_MIGRATION_URL=postgresql+psycopg://USER:PASS@HOST/DB?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379/0
FAYDA_SESSION_TTL_SECONDS=600
FAYDA_RESULT_TTL_SECONDS=900

# Remote HTTP hosting only, configured by the host.
MCP_RESOURCE_URL=https://developer-app.example/mcp
MCP_AUTH_ISSUER=https://developer-auth.example/
MCP_AUTH_JWKS_URL=https://developer-auth.example/jwks
